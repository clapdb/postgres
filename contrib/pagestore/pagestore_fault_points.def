/*
 * Single source of truth for C probes and harness plan validation.
 * Keep every record on one line; the Python harness parses this strict form.
 */
PAGESTORE_FAULT_POINT(DAEMON_AFTER_READY, "daemon.after_ready", "store", "process_abort", "crash|error|pause", 1, 1)
// All publication points below are lock-held and therefore remain crash-only.
PAGESTORE_FAULT_POINT(PAGE_COMPACTION_AFTER_PUBLISH, "page_compaction.after_publish", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(PAGE_GC_AFTER_MARK_DELETE, "page_gc.after_mark_delete", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(PAGE_PRUNE_AFTER_FRONTIER, "page_prune.after_frontier", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(WAL_INDEX_AFTER_FRONTIER, "wal_index.after_frontier", "store", "process_abort", "crash", 1, 0)
// WAL reclaim probes are ordered POSIX-local process-abort boundaries under the
// store lock: after the durable physical frontier and before the first unlink,
// after each authorized segment unlink (hit N = N unlinks), and after the last
// unlink but before the directory fsync that retires the residual prefix.
PAGESTORE_FAULT_POINT(WAL_RECLAIM_BEFORE_UNLINK, "wal_reclaim.before_unlink", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(WAL_RECLAIM_AFTER_UNLINK, "wal_reclaim.after_unlink", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(WAL_RECLAIM_BEFORE_DIR_FSYNC, "wal_reclaim.before_dir_fsync", "store", "process_abort", "crash", 1, 0)
// Timeline deletion probes are lock-held process-abort boundaries: after the
// fsync'd DELETING event and before its in-memory publication, after the
// owner's private WAL/WAL-index artifacts are removed, after the first hole
// of a shared page segment is tombstoned in place and before the rest,
// after a shared page segment's holes are durably synced, and after the
// fsync'd DELETED event and before its in-memory publication.
PAGESTORE_FAULT_POINT(TIMELINE_DELETE_BEFORE_DELETING, "timeline_delete.before_deleting", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(TIMELINE_DELETE_AFTER_DELETING, "timeline_delete.after_deleting", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(TIMELINE_DELETE_AFTER_WAL_CLEANUP, "timeline_delete.after_wal_cleanup", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(TIMELINE_DELETE_MID_SEGMENT_TOMBSTONE, "timeline_delete.mid_segment_tombstone", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(TIMELINE_DELETE_AFTER_SEGMENT_TOMBSTONE, "timeline_delete.after_segment_tombstone", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(TIMELINE_DELETE_AFTER_DELETED, "timeline_delete.after_deleted", "store", "process_abort", "crash", 1, 0)
// Manifest replacement probes bracket the atomic rewrite of layers.manifest
// under map-wr: after the compacted temp file is fsync'd and before the
// rename, and after the rename and before the directory fsync.
PAGESTORE_FAULT_POINT(MANIFEST_COMPACT_AFTER_TMP_SYNC, "manifest_compact.after_tmp_sync", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(MANIFEST_COMPACT_AFTER_RENAME, "manifest_compact.after_rename", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(FORKMETA_AFTER_PREPARE, "forkmeta.after_prepare", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(FORKMETA_AFTER_MANIFEST_COMMIT, "forkmeta.after_manifest_commit", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(FORKMETA_AFTER_SOURCE_REWRITE, "forkmeta.after_source_rewrite", "store", "process_abort", "crash", 1, 0)
PAGESTORE_FAULT_POINT(FORKMETA_AFTER_SNAPSHOT_GC, "forkmeta.after_snapshot_gc", "store", "process_abort", "crash", 1, 0)
// Materializer restartpoint probes are pause-only: the harness kills the
// whole recovery postmaster after the checkpointer reaches the boundary.
PAGESTORE_FAULT_POINT(MATERIALIZER_AFTER_RELATION_SYNC, "materializer.after_relation_sync", "materializer", "process_abort", "pause", 1, 1)
PAGESTORE_FAULT_POINT(MATERIALIZER_AFTER_MARKER_SYNC, "materializer.after_marker_sync", "materializer", "process_abort", "pause", 1, 1)
PAGESTORE_FAULT_POINT(BRANCH_PREPARE_BEFORE_PREPARED_RECEIPT, "branch_prepare.before_prepared_receipt", "branch", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(BRANCH_PREPARE_AFTER_PREPARED_RECEIPT, "branch_prepare.after_prepared_receipt", "branch", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(BRANCH_PREPARE_AFTER_MATERIALIZER_RESUME, "branch_prepare.after_materializer_resume", "branch", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(BRANCH_PREPARE_AFTER_WRITER_RESTORE, "branch_prepare.after_writer_restore", "branch", "process_abort", "crash", 1, 1)
// Image-layer H1 probes are ordered POSIX-local process-abort boundaries: the
// file exists, has been written but not sealed, has been fsync'd, and its ADD
// has been fsync'd in layers.manifest.  after_write is not a power-loss claim.
PAGESTORE_FAULT_POINT(IMAGE_LAYER_AFTER_CREATE, "image_layer.after_create", "store", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(IMAGE_LAYER_AFTER_WRITE, "image_layer.after_write", "store", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(IMAGE_LAYER_AFTER_SEAL, "image_layer.after_seal", "store", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(IMAGE_LAYER_AFTER_MANIFEST_ADD, "image_layer.after_manifest_add", "store", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(BRANCH_INSTALL_AFTER_MAPS, "branch_install.after_maps", "branch", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(BRANCH_INSTALL_AFTER_SLRU_REMOVE, "branch_install.after_slru_remove", "branch", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(BRANCH_INSTALL_BEFORE_MANIFEST, "branch_install.before_manifest", "branch", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(BRANCH_INSTALL_AFTER_MANIFEST, "branch_install.after_manifest", "branch", "process_abort", "crash", 1, 1)
// Retention-log compaction/migration probes bracket the atomic rewrite of
// retention.meta under retention_lock: after the durable pending intent is
// installed and before its temp file is touched, after the temp file is
// fsync'd and before the rename, after the rename and before the directory
// fsync, and after the post-rename committed-prefix state is durable and
// before the pending marker is cleared.
PAGESTORE_FAULT_POINT(RETENTION_COMPACT_AFTER_PENDING, "retention_compact.after_pending", "store", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(RETENTION_COMPACT_AFTER_TMP_SYNC, "retention_compact.after_tmp_sync", "store", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(RETENTION_COMPACT_AFTER_RENAME, "retention_compact.after_rename", "store", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(RETENTION_COMPACT_AFTER_STATE, "retention_compact.after_state", "store", "process_abort", "crash", 1, 1)
// Retention-log in-place append probes: after the durable pending intent is
// installed and before the record is written, and after the appended record
// is fsync'd and before the committed-prefix state is updated.
PAGESTORE_FAULT_POINT(RETENTION_APPEND_AFTER_PENDING, "retention_append.after_pending", "store", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(RETENTION_APPEND_AFTER_WRITE, "retention_append.after_write", "store", "process_abort", "crash", 1, 1)
// One-time PS_RETENTION_PENDING_BOOTSTRAP_STATE probe in ps_retention_open():
// after the durable pending intent (old_nrecords == new_nrecords) is
// installed and before retention.state is written for the first time.
PAGESTORE_FAULT_POINT(RETENTION_BOOTSTRAP_AFTER_PENDING, "retention_bootstrap.after_pending", "store", "process_abort", "crash", 1, 1)
// retention_begin_pending()'s own atomic publish of retention.pending.tmp:
// after the tmp file is created and before it is written (a crash here
// leaves a 0-byte tmp), and after the tmp file is fully written and
// fsync'd and before it is renamed into place (a crash here leaves a
// complete but not-yet-visible tmp).  Neither window has touched
// retention.pending or the log itself.
PAGESTORE_FAULT_POINT(RETENTION_PENDING_AFTER_CREATE, "retention_pending.after_create", "store", "process_abort", "crash", 1, 1)
PAGESTORE_FAULT_POINT(RETENTION_PENDING_AFTER_TMP_SYNC, "retention_pending.after_tmp_sync", "store", "process_abort", "crash", 1, 1)
