{
  "schema": 1,
  "inspection_schema": 1,
  "inspection_operations": ["health", "backpressure"],
  "runtimes": {
    "daemon_smoke": {
      "operations": ["crash"],
      "constraints": {
        "crash": {"target": ["store"], "model": ["power_loss"], "forbidden_fields": ["fault"]}
      },
      "protocol_version": 24,
      "page_size": 8192,
      "io_unit": 262144
    },
    "writer_smoke": {
      "operations": ["sql", "checkpoint", "prepare_reader", "reader_base", "bootstrap", "install_reader", "assert", "capture"],
      "constraints": {
        "checkpoint": {"target": ["writer"]},
        "prepare_reader": {"target": ["writer"]},
        "reader_base": {"target": ["writer"]},
        "bootstrap": {"target": ["writer"]},
        "install_reader": {"forbidden_values": {"target": ["writer"]}},
        "assert": {"oracle": ["sql_scalar"]},
        "capture": {"target": ["writer"], "kind": ["reader_datadir"]}
      },
      "protocol_version": 24,
      "page_size": 8192,
      "io_unit": 262144
    }
  },
  "storage": ["posix"],
  "postgres_major": [13, 14, 15, 16, 17, 18, 19],
  "shards": [1],
  "compute": ["writer", "reader", "branch"],
  "crash_models": ["power_loss", "compute", "process_abort"],
  "operations": [
    "sql",
    "checkpoint",
    "prepare_branch",
    "install_branch",
    "prepare_reader",
    "reader_base",
    "bootstrap",
    "install_reader",
    "restart",
    "crash",
    "advance",
    "assert",
    "parallel",
    "wait",
    "sync",
    "set_fault",
    "release_fault",
    "capture",
    "compare",
    "expect_failure",
    "cleanup"
  ]
}
