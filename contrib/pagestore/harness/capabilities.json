{
  "schema": 1,
  "inspection_schema": 1,
  "inspection_operations": ["health", "backpressure", "pruning"],
  "runtimes": {
    "daemon_smoke": {
      "operations": ["crash"],
      "constraints": {
        "crash": {"target": ["store"], "model": ["power_loss"], "forbidden_fields": ["fault"]}
      },
      "protocol_version": 40,
      "page_size": 8192,
      "io_unit": 262144
    },
    "daemon_fault_smoke": {
      "operations": ["crash", "set_fault", "release_fault"],
      "constraints": {
        "crash": {},
        "set_fault": {},
        "release_fault": {"target": ["store"]}
      },
      "protocol_version": 40,
      "page_size": 8192,
      "io_unit": 262144
    },
    "writer_smoke": {
      "operations": ["sql", "checkpoint", "prepare_reader", "reader_base", "bootstrap", "install_reader", "assert", "capture"],
      "constraints": {
        "checkpoint": {"target": ["writer"]},
        "prepare_reader": {"target": ["writer"]},
        "reader_base": {"target": ["writer"]},
        "bootstrap": {"target": ["writer"]},
        "install_reader": {"forbidden_values": {"target": ["writer"]}},
        "assert": {"oracle": ["sql_scalar"]},
        "capture": {"target": ["writer"], "kind": ["reader_datadir"]}
      },
      "protocol_version": 40,
      "page_size": 8192,
      "io_unit": 262144
    },
    "materializer_smoke": {
      "operations": ["sql", "checkpoint", "crash", "assert"],
      "constraints": {
        "sql": {"target": ["writer"], "forbidden_fields": ["expect_error", "expect_sqlstate"]},
        "checkpoint": {"target": ["writer"]},
        "crash": {"target": ["materializer"], "model": ["compute"], "forbidden_fields": ["fault"]},
        "assert": {"target": ["writer", "materializer"], "oracle": ["sql_scalar"]}
      },
      "protocol_version": 40,
      "page_size": 8192,
      "io_unit": 262144
    }
  },
  "storage": ["posix"],
  "postgres_major": [13, 14, 15, 16, 17, 18, 19],
  "shards": [1],
  "compute": ["writer", "reader", "branch", "materializer"],
  "crash_models": ["power_loss", "compute", "process_abort"],
  "fault_actions": ["crash", "error", "pause"],
  "fault_catalog": "../pagestore_fault_points.def",
  "operations": [
    "sql",
    "checkpoint",
    "prepare_branch",
    "install_branch",
    "prepare_reader",
    "reader_base",
    "bootstrap",
    "install_reader",
    "restart",
    "crash",
    "advance",
    "assert",
    "parallel",
    "wait",
    "sync",
    "set_fault",
    "release_fault",
    "capture",
    "compare",
    "expect_failure",
    "cleanup"
  ]
}
